 {
  "annotations": {
   "openWorldHint": false,
   "readOnlyHint": true
  },
  "description": "Door-to-door trip by public transport on the scheduled timetable: walk, ride (with changes), walk. Up to 3\noptions, each with its legs: times, line, direction, stops, operator. `from` and `to` are points or place names\nin `city`. Leave now (default), at `depart_at`, or arrive by `arrive_by`. Between two listed cities, set\n`to_city` (the city `to` is in): the plan adds trains or FlixBus coaches of the national layer (train,\nplatform, track) and city transport at both ends. For stations in cities that are not listed, or when you\nhandle the way to the station yourself, use plan_stations. Each option has a `trip` reference that render_map\ncan draw (a trip between cities: its part in `city`); it stays valid while the timetable data is the same.",
  "inputSchema": {
   "additionalProperties": false,
   "properties": {
    "arrive_by": {
     "description": "arrive by this time instead (same format); not with depart_at",
     "maxLength": 40,
     "minLength": 1,
     "type": "string"
    },
    "city": {
     "description": "city id from list_cities",
     "maxLength": 40,
     "type": "string"
    },
    "depart_at": {
     "description": "local time, HH:MM or YYYY-MM-DD HH:MM (default now)",
     "maxLength": 40,
     "minLength": 1,
     "type": "string"
    },
    "detail": {
     "default": "summary",
     "description": "full adds geometry (`path`), ids, colours, leg-end points, full data dates",
     "enum": [
      "summary",
      "full"
     ],
     "type": "string"
    },
    "from": {
     "anyOf": [
      {
       "items": {
        "maximum": 180,
        "minimum": -180,
        "type": "number"
       },
       "maxItems": 2,
       "minItems": 2,
       "type": "array"
      },
      {
       "maxLength": 200,
       "minLength": 1,
       "type": "string"
      }
     ],
     "description": "[lat, lon] or a place name in `city`"
    },
    "layer": {
     "description": "the national layer to use, if several are loaded",
     "maxLength": 40,
     "type": "string"
    },
    "max_transfers": {
     "default": 2,
     "maximum": 4,
     "minimum": 0,
     "type": "integer"
    },
    "to": {
     "anyOf": [
      {
       "items": {
        "maximum": 180,
        "minimum": -180,
        "type": "number"
       },
       "maxItems": 2,
       "minItems": 2,
       "type": "array"
      },
      {
       "maxLength": 200,
       "minLength": 1,
       "type": "string"
      }
     ],
     "description": "[lat, lon] or a place name in `city`"
    },
    "to_city": {
     "description": "city id of `to`, for a trip between two cities (needs a national layer)",
     "maxLength": 40,
     "type": "string"
    }
   },
   "required": [
    "city",
    "from",
    "to"
   ],
   "type": "object"
  },
