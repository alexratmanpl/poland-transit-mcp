 {
  "annotations": {
   "openWorldHint": false,
   "readOnlyHint": true
  },
  "description": "Map geometry of a bounding box in one city (at most about 18 km across), for code that draws its own\nmap: lines and polygons cut at the box, grouped by layer, as [lat, lon] points, simplified until they fit\n`max_points` (a layer that still does not fit is left out and named in the note). For a picture use\nrender_map.",
  "inputSchema": {
   "additionalProperties": false,
   "properties": {
    "bbox": {
     "description": "[minLat, minLon, maxLat, maxLon]",
     "items": {
      "maximum": 180,
      "minimum": -180,
      "type": "number"
     },
     "maxItems": 4,
     "minItems": 4,
     "type": "array"
    },
    "city": {
     "description": "city id",
     "maxLength": 40,
     "type": "string"
    },
    "layers": {
     "description": "default: all but paths",
     "items": {
      "enum": [
       "water",
       "parks",
       "streets_major",
       "streets_minor",
       "paths",
       "rail",
       "tram",
       "stops"
      ],
      "type": "string"
     },
     "maxItems": 8,
     "type": "array"
    },
    "max_points": {
     "default": 1000,
     "description": "the most points to return (default 1000, about 20,000 characters)",
     "maximum": 4000,
     "minimum": 100,
     "type": "integer"
    }
   },
   "required": [
    "city",
    "bbox"
   ],
   "type": "object"
  },
  "name": "map_extract",
  "outputSchema": {
   "properties": {
    "as_of": {
     "additionalProperties": true,
     "description": "publication date per source (YYYY-MM-DD or \"unknown\"; gtfs_<key>: credit <city>/<key>); detail=\"full\": {published, retrieved, valid_from, valid_to} per feed",
     "type": "object"
    },
    "bbox": {
     "items": {
      "type": "number"
     },
     "type": "array"
    },
    "credits": {
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "layers": {
     "additionalProperties": true,
     "description": "per layer: lines as [[lat, lon], ...]; polygons as lists of rings (outer parts and holes), filled even-odd; stops as {id, name, at}",
     "type": "object"
    },
    "note": {
     "type": "string"
    }
   },
   "required": [
    "credits",
    "as_of",
    "bbox",
    "layers"
   ],
   "type": "object"
  },
  "title": "Map data"
 },
 {
  "annotations": {
   "openWorldHint": false,
   "readOnlyHint": true
  },
  "description": "Trains and coaches between stations of a national layer, with no walk or city transport added: for a\ntraveller who starts or ends at a station, and for stations outside the listed cities (also abroad). `from`\nand `to` are lists of stops, each with the minutes needed there before boarding or after arriving, e.g.\n[{\"stop\": \"Kraków Główny\", \"minutes\": 15}]; each option's depart and arrive include those minutes. Up to 3\noptions: the best connections, not every train (for all trains between two stations use departures with\n`to`). FlixBus stops have their own names (e.g. \"Wroclaw, Bus Station\"): find them with find_places on the\nlayer.",
  "inputSchema": {
   "additionalProperties": false,
   "properties": {
    "arrive_by": {
     "description": "arrive by this time instead; not with depart_at",
     "maxLength": 40,
     "minLength": 1,
     "type": "string"
    },
    "depart_at": {
     "description": "HH:MM or YYYY-MM-DD HH:MM (default now)",
     "maxLength": 40,
     "minLength": 1,
     "type": "string"
    },
    "detail": {
     "default": "summary",
     "description": "full adds each leg's path, trip id and colour, the points and city ids of its ends, and full data dates (5 to 9 times larger: train legs are long)",
     "enum": [
      "summary",
      "full"
     ],
     "type": "string"
    },
    "from": {
     "description": "start stops, each with the minutes needed before boarding there",
     "items": {
      "additionalProperties": false,
      "properties": {
       "minutes": {
        "default": 0,
        "description": "minutes needed there (default 0)",
        "maximum": 1440,
        "minimum": 0,
        "type": "integer"
       },
       "stop": {
        "description": "a station or stop name (all its platforms), or a stop_id",
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "stop"
      ],
      "type": "object"
     },
     "maxItems": 20,
     "minItems": 1,
     "type": "array"
    },
    "layer": {
     "description": "the national layer, if several are loaded",
     "maxLength": 40,
     "type": "string"
    },
    "max_transfers": {
     "default": 2,
     "description": "the most changes between vehicles (default 2)",
     "maximum": 4,
     "minimum": 0,
     "type": "integer"
    },
    "to": {
     "description": "end stops, each with the minutes needed after arriving there",
     "items": {
      "additionalProperties": false,
      "properties": {
       "minutes": {
        "default": 0,
        "description": "minutes needed there (default 0)",
        "maximum": 1440,
        "minimum": 0,
        "type": "integer"
       },
       "stop": {
        "description": "a station or stop name (all its platforms), or a stop_id",
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "stop"
      ],
      "type": "object"
     },
     "maxItems": 20,
     "minItems": 1,
     "type": "array"
    }
   },
   "required": [
    "from",
    "to"
   ],
   "type": "object"
  },
  "name": "plan_stations",
  "outputSchema": {
   "$defs": {
    "Leg": {
     "properties": {
      "arrive": {
       "type": "string"
      },
      "category": {
       "description": "left out when it repeats line, unless detail=\"full\"",
       "type": "string"
      },
      "color": {
       "description": "only with detail=\"full\"",
       "type": "string"
      },
      "depart": {
       "type": "string"
      },
      "direction": {
       "type": "string"
      },
      "distance_m": {
       "type": "integer"
      },
      "from": {
       "$ref": "#/$defs/LegEnd"
      },
      "line": {
       "type": "string"
      },
      "minutes": {
       "type": "integer"
      },
      "mode": {
