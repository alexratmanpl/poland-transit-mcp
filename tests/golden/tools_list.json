      },
      "color": {
       "description": "only with detail=\"full\"",
       "type": "string"
      },
      "depart": {
       "type": "string"
      },
      "direction": {
       "type": "string"
      },
      "distance_m": {
       "type": "integer"
      },
      "from": {
       "$ref": "#/$defs/LegEnd"
      },
      "line": {
       "type": "string"
      },
      "minutes": {
       "type": "integer"
      },
      "mode": {
       "type": "string"
      },
      "operator": {
       "type": "string"
      },
      "path": {
