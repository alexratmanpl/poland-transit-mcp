  },
  "description": "The full credit and licence of each data source, by the ids answers carry in `credits` (answers hold only\nthe ids). Show the text of each id, and the notice, wherever the data is shown to people. The same set is\nthe resource credits://all.",
  "inputSchema": {
   "additionalProperties": false,
   "properties": {
    "ids": {
     "description": "ids from an answer's `credits`, e.g. [\"osm\"] (default: every source)",
     "items": {
      "maxLength": 80,
      "type": "string"
     },
     "maxItems": 50,
     "type": "array"
    }
   },
   "type": "object"
  },
  "name": "credits",
  "outputSchema": {
   "$defs": {
    "CreditEntry": {
     "properties": {
      "city": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "licence": {
       "type": "string"
      },
      "text": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "text"
     ],
     "type": "object"
    }
   },
   "properties": {
    "about": {
     "type": "string"
    },
    "credits": {
     "items": {
      "$ref": "#/$defs/CreditEntry"
     },
     "type": "array"
    },
    "note": {
     "type": "string"
    },
    "notice": {
     "type": "string"
    }
   },
   "required": [
    "credits",
    "notice",
    "about"
   ],
   "type": "object"
  },
  "title": "Data credits"
 },
 {
  "annotations": {
   "openWorldHint": true,
   "readOnlyHint": true
  },
  "description": "Next scheduled departures from one stop: line, direction, time and operator, with live estimates where the\ncity offers them and the server has them on (flagged \"live\"). `at` picks another time or day. On a national\nlayer such as \"poland\" pass a station name: each departure also gives the train (number or name), category,\nplatform and track.",
  "inputSchema": {
   "additionalProperties": false,
   "properties": {
    "at": {
     "description": "local time, HH:MM or YYYY-MM-DD HH:MM (default now)",
     "maxLength": 40,
     "minLength": 1,
     "type": "string"
    },
    "city": {
     "description": "city id from list_cities",
     "maxLength": 40,
     "type": "string"
    },
    "detail": {
     "default": "summary",
     "description": "full adds geometry (`path`), ids, colours, leg-end points, full data dates",
     "enum": [
      "summary",
      "full"
     ],
     "type": "string"
    },
    "limit": {
     "default": 10,
     "maximum": 50,
     "minimum": 1,
     "type": "integer"
    },
    "line": {
     "description": "only this line, e.g. \"8\"",
     "maxLength": 60,
     "type": "string"
    },
    "stop_id": {
     "description": "a stop name (all its platforms) or one stop_id from find_places/stops_near",
     "maxLength": 200,
     "minLength": 1,
     "type": "string"
    }
   },
   "required": [
    "city",
    "stop_id"
   ],
   "type": "object"
  },
  "name": "departures",
  "outputSchema": {
   "$defs": {
    "Departure": {
     "properties": {
      "category": {
       "type": "string"
      },
      "color": {
       "description": "only with detail=\"full\"",
       "type": "string"
      },
      "date": {
       "type": "string"
      },
      "direction": {
       "type": "string"
      },
      "line": {
       "type": "string"
      },
      "mode": {
       "type": "string"
      },
      "operator": {
       "type": "string"
      },
      "platform": {
       "type": "string"
      },
      "status": {
       "type": "string"
      },
      "stop_id": {
       "type": "string"
      },
      "time": {
       "type": "string"
      },
      "track": {
       "type": "string"
      },
      "train": {
       "type": "string"
      },
      "trip_id": {
       "description": "only with detail=\"full\"",
       "type": "string"
      }
     },
     "required": [
      "time",
      "line",
      "direction"
     ],
     "type": "object"
    }
   },
   "properties": {
    "as_of": {
     "additionalProperties": true,
     "description": "publication date per source (YYYY-MM-DD or \"unknown\"; gtfs_<key>: credit <city>/<key>); detail=\"full\": {published, retrieved, valid_from, valid_to} per feed",
     "type": "object"
    },
    "at": {
     "type": "string"
    },
    "credits": {
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "departures": {
     "items": {
      "$ref": "#/$defs/Departure"
     },
     "type": "array"
    },
    "live": {
     "type": "string"
    },
    "note": {
     "type": "string"
    },
    "stop": {
     "additionalProperties": true,
     "type": "object"
    }
   },
   "required": [
    "credits",
    "as_of",
    "departures"
   ],
   "type": "object"
  },
  "title": "Departures from a stop"
 },
 {
  "annotations": {
   "openWorldHint": false,
   "readOnlyHint": true
  },
  "description": "Find named places in one city by name and/or near a point: attractions, museums, parks, stations, stops,\nhotels, landmarks, streets. Names match with or without Polish diacritics. Returns name, kind and [lat, lon];\nstops also carry `stop_ids` for departures. Only this server's data: no street addresses. On a national layer\n(e.g. \"poland\") it finds stations by name.",
  "inputSchema": {
   "additionalProperties": false,
   "properties": {
    "city": {
     "description": "city id from list_cities",
     "maxLength": 40,
     "type": "string"
    },
    "kinds": {
     "description": "only these kinds, e.g. [\"stop\", \"station\"]",
     "items": {
      "enum": [
       "attraction",
       "museum",
       "park",
       "station",
       "stop",
       "hotel",
       "landmark",
       "street"
      ],
      "type": "string"
     },
     "maxItems": 8,
     "type": "array"
    },
    "limit": {
     "default": 10,
     "maximum": 50,
     "minimum": 1,
     "type": "integer"
    },
    "near": {
     "description": "[lat, lon]",
     "items": {
      "maximum": 180,
      "minimum": -180,
      "type": "number"
     },
     "maxItems": 2,
     "minItems": 2,
     "type": "array"
    },
    "query": {
     "description": "a name or part of one",
     "maxLength": 200,
     "type": "string"
    },
    "radius_m": {
     "description": "metres around `near` (default 1000 without a query)",
     "exclusiveMinimum": 0,
     "maximum": 50000,
     "type": "number"
    }
   },
   "required": [
    "city"
   ],
   "type": "object"
  },
  "name": "find_places",
  "outputSchema": {
   "$defs": {
    "Place": {
     "properties": {
      "at": {
       "items": {
        "type": "number"
       },
       "type": "array"
      },
      "kind": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "stop_ids": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "name",
      "kind",
      "at"
     ],
     "type": "object"
    }
   },
   "properties": {
    "as_of": {
     "additionalProperties": true,
     "description": "publication date per source (YYYY-MM-DD or \"unknown\"; gtfs_<key>: credit <city>/<key>); detail=\"full\": {published, retrieved, valid_from, valid_to} per feed",
     "type": "object"
    },
    "credits": {
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "note": {
     "type": "string"
    },
    "places": {
     "items": {
      "$ref": "#/$defs/Place"
     },
     "type": "array"
    }
   },
   "required": [
    "credits",
    "as_of",
    "places"
   ],
   "type": "object"
  },
  "title": "Find places"
 },
 {
  "annotations": {
   "openWorldHint": false,
   "readOnlyHint": true
  },
  "description": "One line on one date: its directions with stops in order, first and last departure and how often it runs\nthrough the day (at most the 10 busiest directions). On a national layer such as \"poland\", pass a train number\nor name (e.g. \"3120/1\" or \"Karłowicz\") for that train's stops with times, platforms and tracks.",
  "inputSchema": {
   "additionalProperties": false,
   "properties": {
    "city": {
     "description": "city id from list_cities",
     "maxLength": 40,
     "type": "string"
    },
    "date": {
     "description": "YYYY-MM-DD (default today)",
     "maxLength": 10,
     "minLength": 1,
     "type": "string"
    },
    "detail": {
     "default": "summary",
     "description": "full adds geometry (`path`), ids, colours, leg-end points, full data dates",
     "enum": [
      "summary",
      "full"
     ],
     "type": "string"
    },
    "line": {
     "description": "line number or name, e.g. \"8\"; on a national layer also a train number or name",
     "maxLength": 60,
     "minLength": 1,
     "type": "string"
    }
   },
   "required": [
    "city",
    "line"
   ],
   "type": "object"
  },
  "name": "line_info",
  "outputSchema": {
   "properties": {
    "as_of": {
     "additionalProperties": true,
     "description": "publication date per source (YYYY-MM-DD or \"unknown\"; gtfs_<key>: credit <city>/<key>); detail=\"full\": {published, retrieved, valid_from, valid_to} per feed",
     "type": "object"
    },
    "color": {
     "description": "only with detail=\"full\"",
     "type": "string"
    },
    "credits": {
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "date": {
     "type": "string"
    },
    "directions": {
     "description": "a city line: stop names, first and last run, frequency; detail=\"full\": stops as {stop_id, name}, and `path`",
     "items": {
      "additionalProperties": true,
      "type": "object"
     },
     "type": "array"
    },
    "line": {
     "type": "string"
    },
    "note": {
     "type": "string"
    },
    "runs": {
     "description": "a train's stops with times; `trip_id`, `path` only with detail=\"full\"",
     "items": {
      "additionalProperties": true,
      "type": "object"
     },
     "type": "array"
    },
    "train": {
     "type": "string"
    }
   },
   "required": [
    "credits",
    "as_of"
   ],
   "type": "object"
  },
  "title": "Line or train"
