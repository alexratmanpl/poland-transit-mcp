 {
  "annotations": {
   "openWorldHint": false,
   "readOnlyHint": true
  },
  "description": "Simplified map geometry for drawing your own map of a bounding box in one city (at most about 18 km\nacross): lines and polygons cut at the box, grouped by layer, as [lat, lon] points. Detail is reduced until\nthe layers fit `max_points`; a layer that still does not fit is left out and named in the note. For a\nfinished picture use render_map.",
  "inputSchema": {
   "additionalProperties": false,
   "properties": {
    "bbox": {
     "description": "[minLat, minLon, maxLat, maxLon]",
     "items": {
      "maximum": 180,
      "minimum": -180,
      "type": "number"
     },
     "maxItems": 4,
     "minItems": 4,
     "type": "array"
    },
    "city": {
     "description": "city id from list_cities",
     "maxLength": 40,
     "type": "string"
    },
    "layers": {
     "description": "default: all but paths",
     "items": {
      "enum": [
       "water",
       "parks",
       "streets_major",
       "streets_minor",
       "paths",
       "rail",
       "tram",
       "stops"
      ],
      "type": "string"
     },
     "maxItems": 8,
     "type": "array"
    },
    "max_points": {
     "default": 1000,
     "description": "the most points to return (default 1000, about 20,000 characters)",
     "maximum": 4000,
     "minimum": 100,
     "type": "integer"
    }
   },
   "required": [
    "city",
    "bbox"
   ],
   "type": "object"
  },
  "name": "map_extract",
  "outputSchema": {
   "properties": {
    "as_of": {
     "additionalProperties": true,
     "description": "publication date per source (YYYY-MM-DD or \"unknown\"; gtfs_<key>: credit <city>/<key>); detail=\"full\": {published, retrieved, valid_from, valid_to} per feed",
     "type": "object"
    },
    "bbox": {
     "items": {
      "type": "number"
     },
     "type": "array"
    },
    "credits": {
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "layers": {
     "additionalProperties": true,
     "description": "per layer: lines as [[lat, lon], ...]; polygons as lists of rings (outer parts and holes), filled even-odd; stops as {id, name, at}",
     "type": "object"
    },
    "note": {
     "type": "string"
    }
   },
   "required": [
    "credits",
    "as_of",
    "bbox",
    "layers"
   ],
   "type": "object"
  },
  "title": "Map data"
 },
 {
  "annotations": {
   "openWorldHint": false,
   "readOnlyHint": true
  },
  "description": "Trains and coaches between stations of a national layer (e.g. \"poland\"), with no walk or city transport\nadded. Use it when the traveller starts or ends at a station, for stations outside the listed cities (also\nabroad), or when you plan the way to the station yourself; for a door-to-door trip use plan_trip. `from` and\n`to` are lists of stops, each with the minutes the traveller needs there before boarding (from `depart_at`) or\nafter arriving, e.g. [{\"stop\": \"Kraków Główny\", \"minutes\": 15}]. Each option's depart and arrive include those\nminutes, and it names the stops it used. Up to 3 options. FlixBus stops have their own names (e.g. \"Wroclaw,\nBus Station\"): find them with find_places on the layer.",
  "inputSchema": {
   "additionalProperties": false,
   "properties": {
    "arrive_by": {
     "description": "arrive by this time instead (same format); not with depart_at",
     "maxLength": 40,
     "minLength": 1,
     "type": "string"
    },
    "depart_at": {
     "description": "local time, HH:MM or YYYY-MM-DD HH:MM (default now)",
     "maxLength": 40,
     "minLength": 1,
     "type": "string"
    },
    "detail": {
     "default": "summary",
     "description": "full adds geometry (`path`), ids, colours, leg-end points, full data dates",
     "enum": [
      "summary",
      "full"
     ],
     "type": "string"
    },
    "from": {
     "description": "start stops, each with the minutes needed before boarding there",
     "items": {
      "additionalProperties": false,
      "properties": {
       "minutes": {
        "default": 0,
        "maximum": 1440,
        "minimum": 0,
        "type": "integer"
       },
       "stop": {
        "description": "a station or stop name (all its platforms), or a stop_id",
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "stop"
      ],
      "type": "object"
     },
     "maxItems": 20,
     "minItems": 1,
     "type": "array"
    },
    "layer": {
     "description": "the national layer to use, if several are loaded",
     "maxLength": 40,
     "type": "string"
    },
    "max_transfers": {
     "default": 2,
     "maximum": 4,
     "minimum": 0,
     "type": "integer"
    },
    "to": {
     "description": "end stops, each with the minutes needed after arriving there",
     "items": {
      "additionalProperties": false,
      "properties": {
       "minutes": {
        "default": 0,
        "maximum": 1440,
        "minimum": 0,
        "type": "integer"
       },
       "stop": {
        "description": "a station or stop name (all its platforms), or a stop_id",
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "stop"
      ],
      "type": "object"
     },
     "maxItems": 20,
     "minItems": 1,
     "type": "array"
    }
   },
   "required": [
    "from",
    "to"
   ],
   "type": "object"
  },
  "name": "plan_stations",
  "outputSchema": {
   "$defs": {
    "Leg": {
     "properties": {
      "arrive": {
       "type": "string"
      },
      "category": {
       "description": "left out when it repeats line, unless detail=\"full\"",
