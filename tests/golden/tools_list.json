[
 {
  "annotations": {
   "openWorldHint": false,
   "readOnlyHint": true
  },
  "description": "The full credit and licence text of each data source, by the ids answers carry in `credits`. Show the\ntext of each id, and the notice, wherever the data is shown to people. Each source's name, licence and city\nas separate fields: the resource credits://all.",
  "inputSchema": {
   "additionalProperties": false,
   "properties": {
    "ids": {
     "description": "ids from an answer's `credits`, or city ids for all of a city's sources (default: every source)",
     "items": {
      "maxLength": 80,
      "type": "string"
     },
     "maxItems": 50,
     "type": "array"
    }
   },
   "type": "object"
  },
  "name": "credits",
  "outputSchema": {
   "$defs": {
    "CreditEntry": {
     "properties": {
      "city": {
       "description": "only in the resource credits://all and the published credits file; the credits tool leaves it out",
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "licence": {
       "description": "only in the resource credits://all and the published credits file; the credits tool leaves it out",
       "type": "string"
      },
      "name": {
       "description": "only in the resource credits://all and the published credits file; the credits tool leaves it out",
       "type": "string"
      },
      "text": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "text"
     ],
     "type": "object"
    }
   },
   "properties": {
    "about": {
     "description": "only in the resource credits://all and the published credits file; the credits tool leaves it out",
     "type": "string"
    },
    "credits": {
     "items": {
      "$ref": "#/$defs/CreditEntry"
     },
     "type": "array"
    },
    "note": {
     "type": "string"
    },
    "notice": {
     "type": "string"
    }
   },
   "required": [
    "credits",
    "notice"
   ],
   "type": "object"
  },
  "title": "Data credits"
 },
 {
  "annotations": {
   "openWorldHint": true,
   "readOnlyHint": true
  },
  "description": "Next departures from a stop or station: line, direction, time, operator; on a national layer also the\ntrain (number or name), platform and track. Scheduled times, with live estimates where the server has them on\n(flagged \"live\"). With `to`, only the departures that go on to that stop, each with its arrival time there:\nthe trains or trams from one stop to another.",
  "inputSchema": {
   "additionalProperties": false,
   "properties": {
    "at": {
     "description": "local time, HH:MM or YYYY-MM-DD HH:MM (default now)",
     "maxLength": 40,
     "minLength": 1,
     "type": "string"
    },
    "city": {
     "description": "city id",
     "maxLength": 40,
     "type": "string"
    },
    "detail": {
     "default": "summary",
     "description": "full adds each run's trip_id and colour, and full data dates (about 1.4 times larger)",
     "enum": [
      "summary",
      "full"
     ],
     "type": "string"
    },
    "limit": {
     "default": 10,
     "description": "rows (default 10, at most 50)",
     "maximum": 50,
     "minimum": 1,
     "type": "integer"
    },
    "line": {
     "description": "only this line, e.g. \"8\"",
     "maxLength": 60,
     "type": "string"
    },
    "mode": {
     "description": "only this mode, e.g. \"tram\"",
     "enum": [
      "tram",
      "bus",
      "trolleybus",
      "metro",
      "rail",
      "ferry"
     ],
     "type": "string"
    },
    "stop_id": {
     "description": "a stop name (all its platforms) or one stop_id from find_places/stops_near",
     "maxLength": 200,
     "minLength": 1,
     "type": "string"
    },
    "to": {
     "description": "only departures that go on to this stop (a name or stop_id)",
     "maxLength": 200,
     "minLength": 1,
     "type": "string"
    }
   },
   "required": [
    "city",
    "stop_id"
   ],
   "type": "object"
  },
  "name": "departures",
  "outputSchema": {
   "$defs": {
    "Departure": {
     "properties": {
      "arrive": {
       "type": "string"
      },
      "category": {
       "type": "string"
      },
      "color": {
       "description": "only with detail=\"full\"",
       "type": "string"
      },
      "date": {
       "type": "string"
      },
      "direction": {
       "type": "string"
      },
      "line": {
       "type": "string"
      },
      "mode": {
       "type": "string"
      },
      "operator": {
       "type": "string"
      },
      "platform": {
       "type": "string"
      },
      "status": {
       "type": "string"
      },
      "stop_id": {
       "type": "string"
      },
      "time": {
       "type": "string"
      },
      "track": {
       "type": "string"
      },
      "train": {
       "type": "string"
      },
      "trip_id": {
       "description": "only with detail=\"full\"",
       "type": "string"
      }
     },
     "required": [
      "time",
      "line",
      "direction"
     ],
     "type": "object"
    }
   },
   "properties": {
    "as_of": {
     "additionalProperties": true,
     "description": "publication date per source (YYYY-MM-DD or \"unknown\"; gtfs_<key>: credit <city>/<key>); detail=\"full\": {published, retrieved, valid_from, valid_to} per feed",
     "type": "object"
    },
    "at": {
     "type": "string"
    },
    "credits": {
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "departures": {
     "items": {
      "$ref": "#/$defs/Departure"
     },
     "type": "array"
    },
    "live": {
     "type": "string"
    },
    "note": {
     "type": "string"
    },
    "stop": {
     "additionalProperties": true,
     "type": "object"
    },
    "to": {
     "type": "string"
    }
   },
   "required": [
    "credits",
    "as_of",
    "departures"
   ],
   "type": "object"
  },
  "title": "Departures from a stop"
 },
 {
  "annotations": {
   "openWorldHint": false,
   "readOnlyHint": true
  },
  "description": "Places in one city by name and/or near a point: attractions, museums, parks, stations, stops, hotels,\nlandmarks, streets (no street addresses). Names match with or without Polish diacritics. Returns name, kind\nand [lat, lon]; a stop also has `stop_ids`. On a national layer it finds stations by name.",
  "inputSchema": {
   "additionalProperties": false,
   "properties": {
    "city": {
     "description": "city id",
     "maxLength": 40,
     "type": "string"
    },
    "kinds": {
     "description": "only these kinds, e.g. [\"stop\", \"station\"]",
     "items": {
      "enum": [
       "attraction",
       "museum",
       "park",
       "station",
       "stop",
       "hotel",
       "landmark",
       "street"
      ],
      "type": "string"
     },
     "maxItems": 8,
     "type": "array"
    },
    "limit": {
     "default": 10,
     "description": "places (default 10, at most 50)",
     "maximum": 50,
     "minimum": 1,
     "type": "integer"
    },
    "near": {
     "description": "[lat, lon]",
     "items": {
      "maximum": 180,
      "minimum": -180,
      "type": "number"
     },
     "maxItems": 2,
     "minItems": 2,
     "type": "array"
    },
    "query": {
     "description": "a name or part of one",
     "maxLength": 200,
     "type": "string"
    },
    "radius_m": {
     "description": "metres around `near` (default 1000 without a query)",
     "exclusiveMinimum": 0,
     "maximum": 50000,
     "type": "number"
    }
   },
   "required": [
    "city"
   ],
   "type": "object"
  },
  "name": "find_places",
  "outputSchema": {
   "$defs": {
    "Place": {
     "properties": {
      "at": {
       "items": {
        "type": "number"
       },
       "type": "array"
      },
      "kind": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "stop_ids": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "name",
      "kind",
      "at"
     ],
     "type": "object"
    }
   },
   "properties": {
    "as_of": {
     "additionalProperties": true,
     "description": "publication date per source (YYYY-MM-DD or \"unknown\"; gtfs_<key>: credit <city>/<key>); detail=\"full\": {published, retrieved, valid_from, valid_to} per feed",
     "type": "object"
    },
    "credits": {
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "note": {
     "type": "string"
    },
    "places": {
     "items": {
      "$ref": "#/$defs/Place"
     },
     "type": "array"
    }
   },
   "required": [
    "credits",
    "as_of",
    "places"
   ],
   "type": "object"
  },
  "title": "Find places"
 },
 {
  "annotations": {
   "openWorldHint": false,
   "readOnlyHint": true
  },
  "description": "One line on one date: its directions with stops in order, first and last departure and how often it\nruns through the day (at most the 10 busiest directions). On a national layer, a train's number or name (e.g.\n\"3120/1\" or \"Karłowicz\") gives that train's stops with times, platforms and tracks.",
  "inputSchema": {
   "additionalProperties": false,
   "properties": {
    "city": {
     "description": "city id",
     "maxLength": 40,
     "type": "string"
    },
    "date": {
     "description": "YYYY-MM-DD (default today)",
     "maxLength": 10,
     "minLength": 1,
     "type": "string"
    },
    "detail": {
     "default": "summary",
     "description": "full adds each direction's path, stops as {stop_id, name}, the colour, a train's trip_id and path, and full data dates (3 to 6 times larger, at most 40,000 characters)",
     "enum": [
      "summary",
      "full"
     ],
     "type": "string"
    },
    "line": {
     "description": "line number or name, e.g. \"8\"; on a national layer also a train number or name",
     "maxLength": 60,
     "minLength": 1,
     "type": "string"
    }
   },
   "required": [
    "city",
    "line"
   ],
   "type": "object"
  },
  "name": "line_info",
  "outputSchema": {
   "properties": {
    "as_of": {
     "additionalProperties": true,
     "description": "publication date per source (YYYY-MM-DD or \"unknown\"; gtfs_<key>: credit <city>/<key>); detail=\"full\": {published, retrieved, valid_from, valid_to} per feed",
     "type": "object"
    },
    "color": {
     "description": "only with detail=\"full\"",
     "type": "string"
    },
    "credits": {
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "date": {
     "type": "string"
    },
    "directions": {
     "description": "a city line: stop names, first and last run, frequency; detail=\"full\": stops as {stop_id, name}, and `path`",
     "items": {
      "additionalProperties": true,
      "type": "object"
     },
     "type": "array"
    },
    "line": {
     "type": "string"
    },
    "note": {
     "type": "string"
    },
    "runs": {
     "description": "a train's stops with times; `trip_id`, `path` only with detail=\"full\"",
     "items": {
      "additionalProperties": true,
      "type": "object"
     },
     "type": "array"
    },
    "train": {
     "type": "string"
    }
   },
   "required": [
    "credits",
    "as_of"
   ],
   "type": "object"
  },
  "title": "Line or train"
 },
