 {
  "annotations": {
   "openWorldHint": false,
   "readOnlyHint": true
  },
  "description": "A picture of an area and/or a trip in one city (at most about 18 km across): map layers, the trip's walks\ndotted, its rides in line colours with the line number, stops as circles. Pass `trip` from a plan_trip option,\na `bbox`, or both. A trip longer than one map is drawn from its start, with an arrow at the edge giving the\ndistance to its end. Returns a PNG image after the JSON; output=\"svg\" returns the SVG source as text instead\n(large). Draw a map only when the user asks for one: the plan's text already holds everything it shows.",
  "inputSchema": {
   "additionalProperties": false,
   "properties": {
    "bbox": {
     "description": "[minLat, minLon, maxLat, maxLon]",
     "items": {
      "maximum": 180,
      "minimum": -180,
      "type": "number"
     },
     "maxItems": 4,
     "minItems": 4,
     "type": "array"
    },
    "city": {
     "description": "city id from list_cities",
     "maxLength": 40,
     "type": "string"
    },
    "itinerary": {
     "description": "rather pass `trip`; else a whole option of a plan made with detail=\"full\"",
     "properties": {
      "legs": {
       "items": {
        "properties": {
         "color": {
          "maxLength": 20,
          "type": "string"
         },
         "from": {
          "properties": {
           "at": {
            "items": {
             "maximum": 180,
             "minimum": -180,
             "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
           },
           "name": {
            "maxLength": 200,
            "type": "string"
           }
          },
          "type": "object"
         },
         "line": {
          "maxLength": 60,
          "type": "string"
         },
         "mode": {
          "maxLength": 20,
          "type": "string"
         },
         "path": {
          "items": {
           "items": {
            "maximum": 180,
            "minimum": -180,
            "type": "number"
           },
           "maxItems": 2,
           "minItems": 2,
           "type": "array"
          },
          "maxItems": 5000,
          "type": "array"
         },
         "to": {
          "properties": {
           "at": {
            "items": {
             "maximum": 180,
             "minimum": -180,
             "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
           },
           "name": {
            "maxLength": 200,
            "type": "string"
           }
          },
          "type": "object"
         }
        },
        "type": "object"
       },
       "maxItems": 30,
       "minItems": 1,
       "type": "array"
      }
     },
     "required": [
      "legs"
     ],
     "type": "object"
    },
    "output": {
     "default": "png",
     "description": "svg returns the source as text (large)",
     "enum": [
      "png",
      "svg"
     ],
     "type": "string"
    },
    "size": {
     "description": "the longer side in pixels (default: 784 for an area; a trip map within about 300 image patches)",
     "maximum": 2000,
     "minimum": 100,
     "type": "integer"
    },
    "style": {
     "additionalProperties": {
      "maxLength": 20,
      "type": "string"
     },
     "description": "colours by layer, e.g. {\"water\": \"#9cc3e6\"}",
     "maxProperties": 16,
     "propertyNames": {
      "maxLength": 20
     },
     "type": "object"
    },
    "trip": {
     "description": "the `trip` value of a plan_trip option",
     "maxLength": 2000,
     "type": "string"
    }
   },
   "required": [
    "city"
   ],
   "type": "object"
  },
